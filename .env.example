# MongoDB Atlas Database Connection URI
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/styleup?retryWrites=true&w=majority

# Next.js Server & Application Origin
APP_ORIGIN=https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Set true on HTTPS deployments (Vercel automatically sets HTTPS)
COOKIE_SECURE=true

# Initial administrator configuration (Run npm run admin:create, then remove ADMIN_PASSWORD)
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Store Administrator
ADMIN_PASSWORD=change_this_password_12chars

# Optional integrations
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
NEXT_PUBLIC_CHAT_URL=
